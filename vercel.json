{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "technohealth.vercel.app" }],
      "destination": "https://www.technohealth.ca/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "technohealth.vercel.app" }],
      "destination": "https://www.technohealth.ca/",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
